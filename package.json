{
  "name": "ai-arena",
  "private": true,
  "workspaces": [
    "packages/*",
    "apps/*",
    "agents/*"
  ],
  "scripts": {
    "dev:server": "bun run --cwd apps/server dev",
    "dev:viewer": "bun run --cwd apps/viewer dev",
    "test": "bun test --recursive",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "bun-types": "^1.3.10",
    "typescript": "^5.9.3"
  }
}
